{
  "version": "0.2.0",
  "configurations": [
    {
      // Run in a debug terminal rather than as a plain node launch, so the
      // output can be teed to a file named for when the run started
      "name": "dev-runner (Electron, log to /tmp/freetube-dev-<start time>.log)",
      "type": "node-terminal",
      "request": "launch",
      "command": "node _scripts/dev-runner.js --remote-debug 2>&1 | tee \"/tmp/freetube-dev-$(date +%Y-%m-%dT%H-%M-%S).log\"",
      "cwd": "${workspaceFolder}",
      "env": {
        // The devcontainer has no user namespace for the Chromium sandbox
        "ELECTRON_DISABLE_SANDBOX": "1",
        // Auto-opened devtools crash the renderer under WSLg (SIGTRAP)
        "FT_NO_DEVTOOLS": "1"
      }
    },
    {
      "name": "dev-runner (Electron, renderer log)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/_scripts/dev-runner.js",
      "env": {
        "ELECTRON_DISABLE_SANDBOX": "1",
        "FT_NO_DEVTOOLS": "1",
        // Forwards renderer console messages to the terminal, so the app can
        // be observed without devtools (which crash the renderer under WSLg)
        "ELECTRON_ENABLE_LOGGING": "1"
      }
    },
    {
      "name": "Attach to renderer process (Electron)",
      "type": "chrome",
      "request": "attach",
      "port": 9223,
      "webRoot": "http://localhost:9080",
      "sourceMapPathOverrides": {
        "webpack://fjernsyn/./~/*": "${workspaceFolder}/node_modules/*",
        "webpack://fjernsyn/./*": "${workspaceFolder}/*"
      }
    }
  ]
}
