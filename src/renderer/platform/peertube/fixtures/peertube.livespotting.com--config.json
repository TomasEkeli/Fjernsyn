        "css": "/* ==================================================\n   TEIL 1: EURE FARBEN\n   ================================================== */\n:root {\n  --primary: #0085e9 !important;\n  --mainColor: #0085e9 !important;\n  --border-primary: #0085e9 !important;\n  --on-primary: #ffffff !important;\n  --primary-hover: #006bbd !important;\n  --mainHoverColor: #006bbd !important;\n}\n\n/* ==================================================\n   TEIL 2: MENÜ BEREINIGEN (Link-Methode)\n   ================================================== */\n\n/* 1. Versteckt den Link, der zu \"joinpeertube.org\" führt \n   (Das ist der Text \"Plattform basierend auf...\") */\na[href*=\"joinpeertube.org\"] {\n    display: none !important;\n    visibility: hidden !important;\n    opacity: 0 !important;\n    height: 0 !important;\n    width: 0 !important;\n    pointer-events: none !important;\n}\n\n/* 2. Versteckt den Link, der zu \"/instances\" führt \n   (Das ist \"Weitere Plattformen...\") */\na[href*=\"/instances\"] {\n    display: none !important;\n    visibility: hidden !important;\n    opacity: 0 !important;\n    height: 0 !important;\n    width: 0 !important;\n    pointer-events: none !important;\n}\n\n/* 3. Zur Sicherheit: Auch die Container verstecken, falls PeerTube die Klassen nutzt */\n.powered-by-peertube {\n    display: none !important;\n}\n\n.peertube-instances {\n    display: none !important;\n}\n\n/* 4. Den letzten Trennstrich entfernen */\n.menu-panel .divider:last-of-type {\n    display: none !important;\n}"
